{
  "name": "dsh-qq-console-v2",
  "displayName": "DSH QQ 控制台 2.2",
  "description": "把手机 QQ 变成 DeepSeek Harness 的遥控器 — 项目管理、会话绑定、任务确认、排队/引导/打断、实时流式进度、模型与推理强度、权限切换，以及完整的安装/卸载支持。",
  "version": "2.2.24",
  "author": "shenhua725",
  "repository": {
    "type": "git",
    "url": "https://github.com/shenhua725/dsh-qq-console.git"
  },
  "homepage": "https://github.com/shenhua725/dsh-qq-console#readme",
  "bugs": {
    "url": "https://github.com/shenhua725/dsh-qq-console/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "qq",
    "qqbot",
    "remote-control",
    "automation"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/catalog.js && node --check lib/client.js && node --check lib/console.js && node --check lib/gateway.js && node --check lib/index.js && node --check lib/menu.js && node --check lib/secure-store.js && node --check lib/sessions.js && node --check lib/store.js",
    "test": "node .selftest/v2.mjs && node .selftest/blank-sessions.mjs && node .selftest/gateway-loop.mjs",
    "test:host": "node .selftest/host-load.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
